#!/usr/bin/env bash

# yzi doesn't seem to inherit the $PATH from ghostty (zsh)

# Use yazi to select a directory
tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
ghostty -e yazi --cwd-file="$tmp"

# Check if yazi actually wrote a file and has content
if [ ! -s "$tmp" ]; then
  # User likely quit yazi without selecting anything (e.g., with 'q')
  rm -f -- "$tmp"
  exit 1
fi

echo $PATH

IFS= read -r -d '' selected <"$tmp"
rm -f -- "$tmp"

if [ -n "$selected" ]; then
  nohup zsh -c 'cd "$1" && neovide .' _ "$selected" >/dev/null 2>&1 &
fi
