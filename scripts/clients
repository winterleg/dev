#!/usr/bin/env bash

printf '\e[?7l'

backend=auto

case "$1" in
--sway)
	backend=sway
	shift
	;;
--i3)
	backend=i3
	shift
	;;
--hypr)
	backend=hypr
	shift
	;;
esac

flags="${1#-}"
[ -z "$flags" ] && flags="cxwt"

#    show_addr  = index(flags, "a")
#    show_class = index(flags, "c")
#    show_xway  = index(flags, "x")
#    show_ws    = index(flags, "w")
#    show_title = index(flags, "t")
#    show_pid   = index(flags, "p")

if [[ $backend == auto ]]; then
	if [[ -n $SWAYSOCK ]]; then
		backend=sway
	elif [[ -n $HYPRLAND_INSTANCE_SIGNATURE ]]; then
		backend=hypr
	elif [[ -n $I3SOCK ]] || [[ $DESKTOP_SESSION == i3* ]] || [[ $XDG_CURRENT_DESKTOP == i3* ]]; then
		backend=i3
	else
		echo "Unable to determine compositor." >&2
		exit 1
	fi
fi

if [[ $backend == hypr ]]; then
	active=$(hyprctl activewindow -j | jq -r .address)

	data=$(
		hyprctl clients -j |
			jq -r '.[] |
            [.address,
             .class,
             (.xwayland|tostring),
             .workspace.id,
             .title,
             .pid] | @tsv'
	)

elif [[ $backend == i3 ]]; then
	active=$(i3-msg -t get_tree |
		jq -r '.. | objects | select(.type=="con" and .focused==true) | .id' |
		head -n1)

	data=$(
		i3-msg -t get_tree |
			jq -r '
    .. | select(.type? == "workspace") | . as $ws
    | (.nodes[], .floating_nodes[]?)
    | ..
    | select(.type? == "con"
        and (.nodes | length == 0)
        and (.floating_nodes | length == 0)
        and (.window != null or .window_properties != null))
    | [
        (.id|tostring),
        (.window_properties.class // ""),
        "false",
        ($ws.name // ""),
        (.name // ""),
        (.pid // "")
      ]
    | @tsv
  '
	)

elif [[ $backend == sway ]]; then
	active=$(swaymsg -t get_tree |
		jq -r '.. | objects | select(.focused==true) | .id' |
		head -n1)

	data=$(
		swaymsg -t get_tree |
			jq -r '
    def leaves:
      recurse(.nodes[]?, .floating_nodes[]?)
      | select(.type == "con" and (.nodes | length == 0) and (.floating_nodes | length == 0));

    leaves
    | select(.app_id != null or .window_properties != null)
    | [
        (.id|tostring),
        (.app_id // .window_properties.class // ""),
        (if .shell=="xwayland" then "true" else "false" end),
        (.workspace.name // .workspace.num // ""),
        (.name // ""),
        (.pid // "")
      ]
    | @tsv
  '
	)
fi

printf "%s\n" "$data" |
	sort -k4,4n -k2,2 |
	awk -F'\t' -v active="$active" -v flags="$flags" -v backend="$backend" '
BEGIN {
    show_addr  = index(flags, "a")
    show_class = index(flags, "c")
    show_xway  = (backend == "i3" ? 0 : index(flags, "x"))
    show_ws    = index(flags, "w")
    show_title = index(flags, "t")
    show_pid   = index(flags, "p")
}
{
    if (length($2) > max_class) max_class = length($2)
    data[NR] = $0
}
END {
    for (i = 1; i <= NR; i++) {
        split(data[i], f, "\t")
        mark = (f[1] == active ? "*" : " ")
        line = mark
        if (show_addr)  line = line sprintf(" address: %s", f[1])
        if (show_class) line = line sprintf(" class: %-" max_class "s", f[2])
        if (show_xway)  line = line sprintf(" xwayland: %6s", f[3])
        if (show_ws)    line = line sprintf(" workspace: %3s", f[4])
        if (show_title) line = line sprintf(" title: %s", f[5])
        if (show_pid)   line = line sprintf(" pid: %s", f[6])
        print line
    }
}'

printf '\e[?7h'
