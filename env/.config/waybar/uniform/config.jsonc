{
    "layer": "top",
    "position": "bottom",
    "height": 24,
    "modules-left": [
        "custom/sep",
        "hyprland/workspaces"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "tray",
        "custom/sep",
        "hyprland/language",
        "custom/sep",
        "pulseaudio",
        "custom/sep",
        "clock",
        "custom/sep",
        "battery",
        "custom/sep"
    ],
    "custom/sep": {
        "format": "  "
    },
    "hyprland/workspaces": {
        "format": "{}"
    },
    "clock": {
        "tooltip": true,
        "format": "{:%y/%m/%d :: %H:%M}"
    },
    "tray": {
        "icon-size": 12,
        "show-passive-items": "true"
    },
    "pulseaudio": {
        "format": "{volume}",
        "format-bluetooth": "{volume}%",
        "format-muted": "{volume}%",
        "format-icons": {
            "default": [
                "",
                ""
            ]
        },
        "scroll-step": 2,
        "on-click": "hyprctl dispatch exec pavucontrol",
        "on-click-right": "pactl set-source-mute @DEFAULT_SOURCE@ toggle"
    }
}
