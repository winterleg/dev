{
    "layer": "top",
    "position": "bottom",
    "output": "eDP-1",
    "exclusive": true,
    "modules-left": [
        "memory",
        "custom/sep",
        "cpu",
        "custom/sep",
        "wlr/taskbar"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "tray"
    ],
    "hyprland/workspaces": {
        "format": "{name}",
        "all-outputs": false
    },
    "custom/sep": {
        "format": " "
    },
    "tray": {
        "show-passive-items": "true"
    },
    "clock": {
        "tooltip": true,
        "format": "{:%H:%M}"
    },
    "wlr/taskbar": {
        "all-outputs": false,
        "bar-css-states": true
    }
}
