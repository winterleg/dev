{
    "layer": "top",
    "position": "bottom",
    "output": "eDP-1",
    "exclusive": true,
    "modules-left": [
        "battery",
        "custom/sep",
        "memory",
        "custom/sep",
        "cpu"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
