[global]
    sort = update
    monitor = 1
    width = (250, 500)
    height = (50, 500)
    notification_limit = 10
    offset = (50, 50)
    transparency = 10
    padding = 8
    horizontal_padding = 8
    frame_width = 2
    frame_color = "#3e2e4f"
    separator_color = auto
    font = Fira Code Retina 14
    corner_radius = 8

[urgency_low]
    background = "#191724"
    foreground = "#e0def4"
    timeout = 3

[urgency_normal]
    background = "#1f1d2e"
    foreground = "#e0def4"
    timeout = 6

[urgency_critical]
    background = "#eb6f92"
    foreground = "#191724"
    timeout = 0
