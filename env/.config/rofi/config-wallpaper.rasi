@import "~/.config/rofi/config.rasi"
@import "colors-rofi.rasi"

configuration {
    modi: "drun";
}

* {
    background-color: transparent;
    text-color: @on-surface;
    font: "Miracode 20";
}

window {
    width: 90%;
    height: 40%;
    background-color: @surface;
    location: center;
    anchor: center;
}

mainbox {
    children: [ "inputbar", "listview"];
}

inputbar {
    background-color: @surface-container-high;
    text-color: @on-surface;
    border-radius: 6px;
    padding: 8px;
}

entry {
    expand: true;
    placeholder: " 🎞️ Search";
    text-color: @on-surface;
}

listview {
    columns: 5;
    lines: 5;
    spacing: 0px;
    padding: 0px;
    flow: horizontal;
    fixed-width: true;
    fixed-height: true;
    cycle: true;
}

element {
    orientation: vertical;
    padding: 0px;
    spacing: 0px;
    border-radius: 10px;
    background-color: @surface-container;
    margin: 4px;
}

element normal {
    background-color: transparent;
}

element selected.normal {
    background-color: @primary;
    text-color: @tertiary;
}

element-text {
    background-color: @surface-container-low;
    text-color: @on-surface;
    vertical-align: 0.5;
    border-radius: 6px;
}
