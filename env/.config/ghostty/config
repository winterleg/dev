background = #000000

cursor-color = EC5D2A


background-opacity = 0.02
# background-opacity = 1
background-blur    = false

confirm-close-surface = false

font-family  = "comic code"
font-family  = "Zen Maru Gothic"
font-size    = 20
font-feature = -calt, -liga, -dlig

gtk-single-instance = true
gtk-tabs-location   = bottom
gtk-wide-tabs       = false
gtk-toolbar-style   = raised

# shell-integration-features = no-cursor

bell-features = no-title

config-file = ?auto/theme.ghostty

window-inherit-working-directory = true
window-padding-balance           = true
window-padding-y                 = 0
window-decoration                = server

adjust-cursor-thickness = 3

keybind = ctrl+)=reset_font_size
keybind = ctrl+]=goto_split:previous

app-notifications = no-config-reload


quit-after-last-window-closed = true
quit-after-last-window-closed-delay = 5h
