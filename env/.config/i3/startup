#!/usr/bin/env bash

~/.config/polybar/launch.sh &
~/.config/i3/xrandr.sh &
~/.config/i3/i3-cycle-focus.py --history 2 &

blueman-applet &
ckb-next-daemon &
dunst &
nm-applet &
udiskie --tray &
/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &
gnome-keyring-daemon --start --components=secrets &
systemctl --user enable --now opentabletdriver.service &
systemctl enable --now auto-cpufreq.service &
fastcompmgr -m 1 -C -i 0.86 -e 1 -D 0 &
unclutter --timeout 15 &
gammastep -m randr -l 46.3:-72.5 &
greenclip daemon &
xautolock -time 5 -locker "i3lock -c 191724" &


setxkbmap ca
setxkbmap -layout ca
xset r rate 225 100
xset s off
xset dpms 6000 6000 6000

sleep 1

nitrogen --restore
