set $super Mod4
set $alt Mod1
floating_modifier $super

exec --no-startup-id ~/.config/i3/startup

font				pango:Yu Mincho 8

focus_follows_mouse		yes

focus_on_window_activation	none

default_border pixel 0

gaps inner 2
gaps outer 5

client.focused			#191724 #31748f #e0def4 #eb6f92 #31748f
client.focused_inactive		#1f1d2e #403d52 #e0def4 #191724 #403d52
client.focused_tab_title	#1f1d2e #403d52 #e0def4
client.unfocused		#191724 #26233a #908caa #191724 #191724
client.urgent			#191724 #26233a #908caa #191724 #191724

# WM
bindsym $super+c		kill
bindsym $super+F8		exit
bindsym $super+Shift+q		reload
bindsym $super+Escape		exec --no-startup-id i3lock -c 191724
bindsym $super+F9		exec --no-startup-id ~/.config/i3/logout.sh
bindsym $super+v		floating toggle
bindsym $super+f		fullscreen
bindsym $super+Shift+p		move container to output right
bindsym $super+F12		exec --no-startup-id dunstctl history-pop

bindsym $super+j		layout tabbed
bindsym $super+Shift+j		layout stacking
bindsym $super+l		layout toggle split
bindsym $super+y		split horizontal
bindsym $super+u		split vertical

# Apps/Scripts
bindsym $super+Ctrl+v		exec --no-startup-id \
					greenclip print \
					| rofi -dmenu -p "Clipboard" \
					| xclip -selection clipboard
bindsym $super+q			exec --no-startup-id helium-browser
bindsym $super+Return		exec --no-startup-id alacritty -e nvim #~/.cargo/bin/neovide
bindsym $super+Shift+Return	exec --no-startup-id alacritty # neovide -- -u ~/.config/nvim-simple/init.lua
bindsym $super+w		exec --no-startup-id firefox-bin
bindsym $super+Shift+w		exec --no-startup-id thunderbird
# bindsym $super+r		exec --no-startup-id dmenu_run -nb '#191724' -nf '#e0def4' -sb '#31748f' -sf '#191724' -fn 'Comic Code:size=12'
bindsym $super+r		exec --no-startup-id rofi -show drun -no-fixed-num-lines
bindsym $super+Shift+r		exec --no-startup-id dmenu_run -m -1
bindsym $super+semicolon	exec --no-startup-id ~/.config/i3/WallpaperSelect.sh
bindsym $super+Shift+f		exec --no-startup-id pcmanfm
bindsym $super+s		exec --no-startup-id spectacle -i
bindsym Print			exec --no-startup-id spectacle -f
bindsym $super+Shift+s		exec --no-startup-id spectacle -i
bindsym $super+Shift+c		exec --no-startup-id xcolor | xclip -selection clipboard
bindsym $super+period		exec --no-startup-id rofi -modi emoji -show emoji -no-fixed-num-lines
bindsym $super+minus		exec --no-startup-id ~/dotfiles/scripts/tts-neovide
bindsym $super+k			exec --no-startup-id alacritty -e rmpc
bindsym $super+b			exec --no-startup-id pkill polybar || ~/.config/polybar/launch.sh

bindsym $super+Tab		workspace back_and_forth
bindsym $super+p		exec --no-startup-id rofi -show window
bindsym $alt+Tab		exec ~/.config/i3/i3-cycle-focus.py --switch

bindsym $super+slash		workspace 1
bindsym $super+parenleft	workspace 2
bindsym $super+bracketleft	workspace 3
bindsym $super+braceleft	workspace 4
bindsym $super+apostrophe	workspace 5
bindsym $super+dollar		workspace 6
bindsym $super+exclam		workspace 7
bindsym $super+braceright	workspace 8
bindsym $super+bracketright	workspace 9
bindsym $super+parenright	workspace 10

bindsym $super+Shift+slash		move container to workspace 1;  workspace 1
bindsym $super+Shift+parenleft		move container to workspace 2;  workspace 2
bindsym $super+Shift+bracketleft	move container to workspace 3;  workspace 3
bindsym $super+Shift+braceleft		move container to workspace 4;  workspace 4
bindsym $super+Shift+apostrophe		move container to workspace 5;  workspace 5
bindsym $super+Shift+dollar		move container to workspace 6;  workspace 6
bindsym $super+Shift+exclam		move container to workspace 7;  workspace 7
bindsym $super+Shift+braceright		move container to workspace 8;  workspace 8
bindsym $super+Shift+bracketright	move container to workspace 9;  workspace 9
bindsym $super+Shift+parenright		move container to workspace 10; workspace 10

bindsym --whole-window $super+button4 workspace prev
bindsym --whole-window $super+button5 workspace next

bindsym $super+Left   workspace prev
bindsym $super+Right  workspace next

bindsym $super+Ctrl+Left    workspace prev
bindsym $super+Ctrl+Right   workspace next
bindsym $super+Shift+Left   move container to workspace prev
bindsym $super+Shift+Right  move container to workspace next

# Window
bindsym $super+h focus left
bindsym $super+i focus right
bindsym $super+e focus up
bindsym $super+n focus down

bindsym $super+Shift+h move left
bindsym $super+Shift+n move down
bindsym $super+Shift+e move up
bindsym $super+Shift+i move right

bindsym $super+Shift+k resize shrink height 20 px
bindsym $super+Shift+m resize grow height 20 px

bindsym $super+button1 move
bindsym $super+button3 resize

# Sound and brightness
bindsym XF86AudioRaiseVolume  exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%+ && ~/.config/i3/volume-dunst.sh
bindsym XF86AudioLowerVolume  exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%- && ~/.config/i3/volume-dunst.sh
bindsym $super+m                exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle && ~/.config/i3/volume-dunst.sh

bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl -e s 2%+
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl -e s 2%-

# Media control
bindsym XF86AudioNext  exec --no-startup-id playerctl next
bindsym XF86AudioPause exec --no-startup-id playerctl play-pause
bindsym XF86AudioPlay  exec --no-startup-id playerctl play-pause
bindsym XF86AudioPrev  exec --no-startup-id playerctl previous
bindsym XF86AudioMute  exec --no-startup-id playerctl play-pause
bindsym $super+Page_Up   exec --no-startup-id pavucontrol
bindsym $super+Page_Down exec --no-startup-id blueman-manager

# Window rules
for_window [class="steam_app_1551360"] floating enable

for_window [class="Pavucontrol"] \
	floating enable, \
	resize set width 1000 px height 600 px, \
	move position center

for_window [title="Save.*"] \
	floating enable, \
	move position center, \
	resize set width 1000 px height 700 px

assign [title="Minecraft.*"] 4
for_window [title="Minecraft.*"] border none

assign [title="Picture-in-Picture"] 10
for_window [title="Picture-in-Picture"] floating disable

# Workspace settings
workspace 1   output HDMI-0
workspace 2   output HDMI-0
workspace 3   output HDMI-0
workspace 4   output HDMI-0
workspace 5   output HDMI-0
workspace 6   output HDMI-0
workspace 7   output HDMI-0
workspace 8   output HDMI-0
workspace 9   output HDMI-0
workspace 10  output DP-4

