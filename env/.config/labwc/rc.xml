<labwc_config>

  <theme>
    <name>gruvbox-material-dark</name>
    <cornerRadius>0</cornerRadius>
    <font name="Courier Prime Code" size="14" />
  </theme>

  <keyboard>
    <layout>
      <name>ca</name>
    </layout>
    <repeatRate>50</repeatRate>
    <repeatDelay>250</repeatDelay>

    <!-- WM operations -->
    <keybind key="W-Space">
        <action name="ShowMenu" menu="root-menu" />
    </keybind>
    <keybind key="W-c">
      <action name="Close" />
    </keybind>
    <keybind key="W-F8">
      <action name="Exit" />
    </keybind>
    <keybind key="W-Escape">
      <action name="Execute" command="~/.config/hypr/scripts/logout.sh" />
    </keybind>
    <keybind key="W-l">
      <action name="Execute" command="hyprlock" />
    </keybind>
    <keybind key="W-f">
      <action name="ToggleFullscreen" />
    </keybind>
    <keybind key="A-Tab">
      <action name="NextWindow" />
    </keybind>
    <keybind key="A-S-Tab">
      <action name="PrevWindow" />
    </keybind>
    <keybind key="W-Tab">
      <action name="GoToDesktop" to="last" />
    </keybind>
    <keybind key="W-b">
      <action name="Execute" command="~/.config/waybar/waybar.sh" />
    </keybind>
    <keybind key="W-F12">
      <action name="Execute" command="dunstctl history-pop" />
    </keybind>

    <!-- Applications -->
    <keybind key="W-C-v">
      <action name="Execute" command="cliphist list | rofi -config ~/.config/rofi/config-copy.rasi -dmenu -p &quot;Clipboard&quot; | cliphist decode | wl-copy" />
    </keybind>
    <keybind key="W-q">
      <action name="Execute" command="helium-browser" />
    </keybind>
    <keybind key="W-Return">
      <action name="Execute" command="foot" />
    </keybind>
    <keybind key="W-S-Return">
      <action name="Execute" command="~/dotfiles/scripts/fzf-neovide" />
    </keybind>
    <keybind key="W-w">
      <action name="Execute" command="firefox" />
    </keybind>
    <keybind key="W-z">
      <action name="Execute" command="foot -e ~/dotfiles/scripts/fzf-zathura" />
    </keybind>
    <keybind key="W-x">
      <action name="Execute" command="foot -e ~/dotfiles/scripts/fzf-imv" />
    </keybind>
    <keybind key="W-Page_Down">
      <action name="Execute" command="kitty --class=calc tmux new-session qalc" />
    </keybind>
    <keybind key="W-r">
      <action name="Execute" command="rofi -show drun -no-fixed-num-lines" />
    </keybind>
    <keybind key="W-e">
      <action name="Execute" command="~/dotfiles/scripts/wmenu-run-dot" />
    </keybind>
    <keybind key="W-y">
      <action name="Execute" command="~/.config/hypr/scripts/WallpaperSelect.sh" />
    </keybind>
    <keybind key="W-t">
      <action name="Execute" command="~/.config/hypr/scripts/status.sh" />
    </keybind>
    <keybind key="W-S-f">
      <action name="Execute" command="thunar" />
    </keybind>
    <keybind key="W-k">
      <action name="Execute" command="foot -e rmpc" />
    </keybind>
    <keybind key="W-s">
      <action name="Execute" command="~/.config/hypr/scripts/hyprshot.sh simple" />
    </keybind>
    <keybind key="Print">
      <action name="Execute" command="~/.config/hypr/scripts/hyprshot.sh screen" />
    </keybind>
    <keybind key="W-S-s">
      <action name="Execute" command="~/.config/hypr/scripts/hyprshot.sh" />
    </keybind>
    <keybind key="W-S-t">
      <action name="Execute" command="~/.config/hypr/scripts/get-text.sh" />
    </keybind>
    <keybind key="W-S-c">
      <action name="Execute" command="hyprpicker -a" />
    </keybind>
    <keybind key="W-period">
      <action name="Execute" command="rofi -config ~/.config/rofi/config-copy.rasi -modi emoji -show emoji -no-fixed-num-lines -lines 20" />
    </keybind>
    <!-- <keybind key="C-S-o"> -->
    <!--   <action name="Execute" command="wtype -M shift ] -m shift" /> -->
    <!-- </keybind> -->

    <keybind key="W-slash">
      <action name="GoToDesktop" to="1" />
    </keybind>
    <keybind key="W-parenleft">
      <action name="GoToDesktop" to="2" />
    </keybind>
    <keybind key="W-bracketleft">
      <action name="GoToDesktop" to="3" />
    </keybind>
    <keybind key="W-braceleft">
      <action name="GoToDesktop" to="4" />
    </keybind>
    <keybind key="W-apostrophe">
      <action name="GoToDesktop" to="5" />
    </keybind>
    <keybind key="W-dollar">
      <action name="GoToDesktop" to="6" />
    </keybind>
    <keybind key="W-exclam">
      <action name="GoToDesktop" to="7" />
    </keybind>
    <keybind key="W-braceright">
      <action name="GoToDesktop" to="8" />
    </keybind>
    <keybind key="W-bracketright">
      <action name="GoToDesktop" to="9" />
    </keybind>
    <keybind key="W-parenright">
      <action name="GoToDesktop" to="10" />
    </keybind>

    <!-- Move window to workspace -->
    <keybind key="W-S-slash">
      <action name="SendToDesktop" to="1" />
      <action name="GoToDesktop" to="1" />
    </keybind>
    <keybind key="W-S-parenleft">
      <action name="SendToDesktop" to="2" />
      <action name="GoToDesktop" to="2" />
    </keybind>
    <keybind key="W-S-bracketleft">
      <action name="SendToDesktop" to="3" />
      <action name="GoToDesktop" to="3" />
    </keybind>
    <keybind key="W-S-braceleft">
      <action name="SendToDesktop" to="4" />
      <action name="GoToDesktop" to="4" />
    </keybind>
    <keybind key="W-S-apostrophe">
      <action name="SendToDesktop" to="5" />
      <action name="GoToDesktop" to="5" />
    </keybind>
    <keybind key="W-S-dollar">
      <action name="SendToDesktop" to="6" />
      <action name="GoToDesktop" to="6" />
    </keybind>
    <keybind key="W-S-exclam">
      <action name="SendToDesktop" to="7" />
      <action name="GoToDesktop" to="7" />
    </keybind>
    <keybind key="W-S-braceright">
      <action name="SendToDesktop" to="8" />
      <action name="GoToDesktop" to="8" />
    </keybind>
    <keybind key="W-S-bracketright">
      <action name="SendToDesktop" to="9" />
      <action name="GoToDesktop" to="9" />
    </keybind>
    <keybind key="W-S-parenright">
      <action name="SendToDesktop" to="10" />
      <action name="GoToDesktop" to="10" />
    </keybind>

    <!-- Audio -->
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%+ &amp;&amp; ~/.config/hypr/scripts/volume-dunst.sh" />
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%- &amp;&amp; ~/.config/hypr/scripts/volume-dunst.sh" />
    </keybind>
    <keybind key="W-m">
      <action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle &amp;&amp; ~/.config/hypr/scripts/volume-dunst.sh" />
    </keybind>
    <keybind key="W-Page_Up">
      <action name="Execute" command="~/.config/hypr/scripts/change-sound-output.sh" />
    </keybind>

    <!-- Brightness -->
    <keybind key="XF86MonBrightnessUp">
      <action name="Execute" command="brightnessctl -e s 2%+" />
    </keybind>
    <keybind key="XF86MonBrightnessDown">
      <action name="Execute" command="brightnessctl -e s 2%-" />
    </keybind>

    <!-- Media keys -->
    <keybind key="XF86AudioNext">
      <action name="Execute" command="playerctl next" />
    </keybind>
    <keybind key="XF86AudioPause">
      <action name="Execute" command="playerctl play-pause" />
    </keybind>
    <keybind key="XF86AudioPlay">
      <action name="Execute" command="playerctl play-pause" />
    </keybind>
    <keybind key="XF86AudioPrev">
      <action name="Execute" command="playerctl previous" />
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute" command="playerctl play-pause" />
    </keybind>
  </keyboard>

  <mouse>
    <default />
    <context name="Frame">
      <mousebind button="W-Left" action="Press">
        <action name="Focus" />
        <action name="Raise" />
      </mousebind>
      <mousebind button="W-Left" action="Drag">
        <action name="Move" />
      </mousebind>
      <mousebind button="W-Right" action="Press">
        <action name="Focus" />
        <action name="Raise" />
      </mousebind>
      <mousebind button="W-Right" action="Drag">
        <action name="Resize" />
      </mousebind>
    </context>
    <context name="Root">
      <mousebind button="Right" action="Press">
        <action name="ShowMenu" menu="root-menu" />
      </mousebind>
    </context>
  </mouse>

  <libinput>
    <device category="non-touch">
      <accelProfile>flat</accelProfile>
    </device>
  </libinput>

  <desktops>
    <number>3</number>
    <names>
      <name>1</name>
      <name>2</name>
      <name>3</name>
    </names>
  </desktops>

  <resistance>
    <strength>10</strength>
    <window_gap>10</window_gap>
    <monitor_gap>10</monitor_gap>
  </resistance>

  <focus>
    <followMouse>yes</followMouse>
    <focusNew>yes</focusNew>
    <focusLast>yes</focusLast>
  </focus>

  <windowSwitcher>
    <show>yes</show>
    <preview>yes</preview>
    <allDesktops>no</allDesktops>
  </windowSwitcher>

  <placement>
    <policy>UnderMouse</policy>
  </placement>

</labwc_config>
