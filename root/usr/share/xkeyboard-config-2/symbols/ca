xkb_symbols "colemakft" {
    name[Group1]= "French (Colemak French Touch)";
    key.type[Group1] = "EIGHT_LEVEL";

    // Digits
    key <AE01> {[ VoidSymbol      , 1                                                                                       ]}; //
    key <AE02> {[ guillemotleft   , 2                                                                                       ]}; //
    key <AE03> {[ guillemotright  , 3                                                                                       ]}; //
    key <AE04> {[ dollar          , 4                                                                                       ]}; //
    key <AE05> {[ percent         , 5                                                                                       ]}; //
    key <AE06> {[ asciicircum     , 6                                                                                       ]}; //
    key <AE07> {[ ampersand       , 7                                                                                       ]}; //
    key <AE08> {[ asterisk        , 8               , VoidSymbol      , VoidSymbol      , section                           ]}; //
    key <AE09> {[ numbersign      , 9                                                                                       ]}; //
    key <AE10> {[ at              , 0                                                                                       ]}; //

    // Letters, first row
    key <AD01> {[ q               , Q               , asciicircum     , dead_circumflex                                     ]}; //
    key <AD02> {[ w               , W               , less                                                                  ]}; //
    key <AD03> {[ f               , F               , greater         , VoidSymbol      , agrave          , Agrave          ]}; //
    key <AD04> {[ p               , P               , dollar          , VoidSymbol      , ugrave          , Ugrave          ]}; //
    key <AD05> {[ g               , G               , percent                                                               ]}; //
    key <AD06> {[ j               , J               , at                                                                    ]}; //
    key <AD07> {[ l               , L               , ampersand                                                             ]}; //
    key <AD08> {[ o               , O               , asterisk        , multiply        , ocircumflex     , Ocircumflex     ]}; //
    key <AD09> {[ ISO_Level5_Latch, exclam          , apostrophe      , dead_acute                                          ]}; //
    key <AD10> {[ y               , Y               , grave           , dead_grave      , icircumflex     , Icircumflex     ]}; //

    // Letters, second row
    key <AC01> {[ a               , A               , braceleft       , VoidSymbol      , acircumflex     , Acircumflex     ]}; //
    key <AC02> {[ r               , R               , parenleft       , VoidSymbol      , eacute          , Eacute          ]}; //
    key <AC03> {[ s               , S               , parenright      , VoidSymbol      , egrave          , Egrave          ]}; //
    key <AC04> {[ t               , T               , braceright                                                            ]}; //
    key <AC05> {[ d               , D               , equal           , VoidSymbol      , underscore      , underscore      ]}; //
    key <AC06> {[ m               , M               , backslash                                                             ]}; //
    key <AC07> {[ n               , N               , plus                                                                  ]}; //
    key <AC08> {[ e               , E               , minus           , VoidSymbol      , ecircumflex     , Ecircumflex     ]}; //
    key <AC09> {[ i               , I               , slash           , VoidSymbol      , idiaeresis      , Idiaeresis      ]}; //
    key <AC10> {[ u               , U               , quotedbl        , VoidSymbol      , ucircumflex     , Ucircumflex     ]}; //

    // Letters, third row
    key <AB01> {[ z               , Z               , asciitilde      , dead_tilde      , ae              , AE              ]}; //
    key <AB02> {[ x               , X               , bracketleft     , VoidSymbol      , oe              , OE              ]}; //
    key <AB03> {[ c               , C               , bracketright    , VoidSymbol      , ccedilla        , Ccedilla        ]}; //
    key <AB04> {[ v               , V               , underscore                                                            ]}; //
    key <AB05> {[ b               , B               , numbersign                                                            ]}; //
    key <AB06> {[ k               , K               , bar                                                                   ]}; //
    key <AB07> {[ h               , H               , exclam          , notsign                                             ]}; //
    key <AB08> {[ minus           , question        , semicolon       , VoidSymbol                                          ]}; //
    key <AB09> {[ comma           , semicolon       , colon           , colon           , periodcentered                    ]}; //
    key <AB10> {[ period          , colon           , question                                                              ]}; //

    // Pinky keys
    key <AE11> {[ slash           , underscore                                                                              ]}; //
    key <AE12> {[ equal           , plus                                                                                    ]}; //
    key <AD11> {[ bracketleft     , braceleft                                                                               ]}; //
    key <AD12> {[ bracketright    , braceright                                                                              ]}; //
    key <AC11> {[ apostrophe      , quotedbl                                                                                ]}; //
    key <TLDE> {[ grave           , asciitilde                                                                              ]}; //
    key <BKSL> {[ backslash       , bar                                                                                     ]}; //
    key <LSGT> {[ less            , greater                                                                                 ]}; //

    // Space bar
    key <SPCE> {[ space           , U202F           , space           , nobreakspace    , U2019           , U2019           ]}; //         ’ ’

    // The AltGr key is an ISO_Level3_Shift:
    include "level3(ralt_switch)"

    // The “OneDeadKey” is an ISO_Level5_Latch, which is activated by this:
    // (note: MDSW [Mode_switch] is an alias for LVL5 on recent versions of XKB)
    replace key <MDSW> {
        type[Group1] = "ONE_LEVEL",
        symbols[Group1] = [ ISO_Level5_Shift ]
    };
    modifier_map Mod3 { <MDSW> };
};
